{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "liftoff.yaml",
  "description": "LiftOff team config, format version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "liftoff",
    "plugin",
    "project",
    "agents"
  ],
  "definitions": {
    "requiredFlag": {
      "type": "boolean"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\/\\\\])(?![A-Za-z]:)(?!(?:.*[\\/\\\\])?\\.\\.(?:[\\/\\\\]|$)).+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "name80": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "idToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "fieldValues": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]+$"
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name80"
        },
        "fields": {
          "$ref": "#/definitions/fieldValues"
        }
      }
    },
    "issueType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/name80"
        },
        "branchType": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$"
        },
        "readingMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "acceptanceCriteria": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "heading": {
                  "$ref": "#/definitions/name80"
                },
                "field": {
                  "$ref": "#/definitions/idToken"
                }
              }
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/definitions/idToken"
                  },
                  "label": {
                    "$ref": "#/definitions/name80"
                  }
                }
              }
            }
          }
        },
        "template": {
          "type": "string",
          "maxLength": 8000
        },
        "createFields": {
          "$ref": "#/definitions/fieldValues"
        },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/definitions/transition"
            },
            "review": {
              "$ref": "#/definitions/transition"
            },
            "done": {
              "$ref": "#/definitions/transition"
            }
          }
        }
      }
    }
  },
  "properties": {
    "liftoff": {
      "type": "integer",
      "const": 1
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
        },
        "required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "new",
            "existing"
          ]
        },
        "required": {
          "$ref": "#/definitions/requiredFlag"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "copilot"
            ]
          }
        },
        "required": {
          "$ref": "#/definitions/requiredFlag"
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "required": {
          "$ref": "#/definitions/requiredFlag"
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "path": {
                "$ref": "#/definitions/relativePath"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "required": {
          "$ref": "#/definitions/requiredFlag"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/definitions/relativePath"
        },
        "required": {
          "$ref": "#/definitions/requiredFlag"
        }
      }
    },
    "tracker": {
      "type": "object",
      "anyOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": true
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "jira-dc"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,19}$"
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sslVerify": {
              "type": "boolean"
            },
            "readOnly": {
              "type": "boolean"
            }
          }
        },
        "issueTypes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issueType"
          }
        },
        "epicLinkField": {
          "$ref": "#/definitions/idToken"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "const": "jira-dc"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "url",
          "project",
          "server"
        ],
        "properties": {
          "url": true,
          "project": true,
          "server": true
        }
      }
    },
    "codeHost": {
      "type": "object",
      "anyOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": true
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "gitlab"
          ]
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*(?::[0-9]{1,5})?$"
        },
        "conventions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetBranch": {
              "type": "string",
              "pattern": "^(?![-/])(?!.*\\.\\.)(?!.*\\.lock$)[A-Za-z0-9._/-]+$"
            },
            "branchPattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "titlePattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "mrTemplate": {
              "$ref": "#/definitions/relativePath"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[^,\\n\\r]+$"
              }
            },
            "reviewers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "const": "gitlab"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "host"
        ],
        "properties": {
          "host": true
        }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "project",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "project": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,19}$"
              },
              "mode": {
                "enum": [
                  "kanban"
                ]
              },
              "module": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "epics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{1,19}-[0-9]+$"
                }
              },
              "issueTypes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/issueType"
                }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "enum": [
            "assisted",
            "manual"
          ]
        },
        "required": {
          "$ref": "#/definitions/requiredFlag"
        }
      }
    }
  }
}
